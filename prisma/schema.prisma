// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PERSON_INDUSTRY {
  STUDENT
  WORKER
  ENTREPRENEUR
  FREELANCER
  ARTIST
  PROGRAMMER
  DESIGNER
  MARKETER
  ADMINISTRATOR
  WRITER
  TOURIST
  PHOTOGRAPHER
  MUSICIAN
  SALESMAN
  MANAGER
  FINNANCE
  LAWYER
  TEACHER
  RESEARCHER
  ENGINEER
  ARCHITECT
  OTHER
}

enum GENDER_ENUM {
  MALE
  FEMALE
  OTHER
}

model People {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String?
  birthdate DateTime?
  about     String?
  languages String[]
  country   String?
  gender    GENDER_ENUM?
  industry  PERSON_INDUSTRY[]
  User      User?
}

enum SUBSCRIPTION_PLAN_ENUM {
  EXPLORER_PLAN
  WANDERLUST_PLAN
  NOMAD_PLAN
}

enum SUBSCRIPTION_STATUS_ENUM {
  PENDING
  APPROVED
  REJECTEED
  CANCELLED
}

type Subscription {
  type        SUBSCRIPTION_PLAN_ENUM
  status      SUBSCRIPTION_STATUS_ENUM?
  createdDate DateTime
  updatedDate DateTime
}

model User {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  profilePicture String?
  username       String  @unique
  email          String  @unique
  password       String
  person         People  @relation(fields: [personID], references: [id])
  personID       String  @unique @db.ObjectId

  // Gamification
  gamification UserGamification?

  // Sessions data
  sessions          PlaceSession[]        @relation(fields: [sessionsIDs], references: [id])
  sessionsIDs       String[]              @db.ObjectId
  sessionActions    PlaceSessionActions[]
  sessionActionsIDs String[]              @db.ObjectId

  followers              String[]            @db.ObjectId
  following              String[]            @db.ObjectId
  sentFollowRequests     UserFollowRequest[] @relation("UserFollowRequestSender")
  receivedFollowRequests UserFollowRequest[] @relation("UserFollowRequestReceiver")

  visitedPlaces    Places[] @relation("PlaceVisitedBy", fields: [visitedPlacesIDs], references: [id])
  visitedPlacesIDs String[] @db.ObjectId

  discoveredPlaces    Places[] @relation("PlaceDiscoveredBy")
  discoveredPlacesIDs String[] @db.ObjectId

  confirmedPlaces    Places[] @relation("PlaceConfirmedBy", fields: [confirmedPlacesIDs], references: [id])
  confirmedPlacesIDs String[] @db.ObjectId

  // Auth data
  resetPasswordToken       String?
  resetPasswordTokenExpiry DateTime?
  // emailVerified     Boolean               @default(false)
  // emailVerifiedDate DateTime?

  // Util data
  createdDate DateTime

  // Subscription data
  subscription Subscription
}

type UserGamification {
  points Int
}

enum FOLLOW_REQUEST_STATUS_ENUM {
  PENDING
  ACCEPTED
  REJECTED
}

model UserFollowRequest {
  id         String                     @id @default(auto()) @map("_id") @db.ObjectId
  sender     User                       @relation(name: "UserFollowRequestSender", fields: [senderID], references: [id])
  senderID   String                     @db.ObjectId
  receiver   User                       @relation(name: "UserFollowRequestReceiver", fields: [receiverID], references: [id])
  receiverID String                     @db.ObjectId
  status     FOLLOW_REQUEST_STATUS_ENUM
}

enum PlaceConfirmationStatus {
  RECOMMENDED
  APPROVED
  REJECTED
}

enum AMBIENCE_TAG_ENUM {
  ELEGANT
  CREATIVE
  CASUAL
  COZY
  QUIET
  PROFESSIONAL
  RUSTIC
  MINIMALIST
  INDUSTRIAL
  NATURE_INSPIRED
  CHIC
  RETRO
  CULTURAL
  SOPHISTICATED
  TECHNOLOGICAL
  BOHEMIAN
  ZEN
  TRENDY
  VIBRANT
  ASIAN
  COLLABORATIVE
}

enum THEME_TAG_ENUM {
  STARTUPS
  LIBRARY_INSPIRED
  FOCUS_ZONE
  TECH_DRIVEN

  CREATIVE_STUDIO
  ART_AND_DESIGN
  NOMAD_MEETUPS
  CULTURAL_EXCHANGE
  BLOCKCHAIN_AND_WEB3

  HEALTH_AND_WELLNESS
  ECO_FRIENDLY
  COFFEE_CULTURE
  LUXURY_AND_COMFORT

  EVENT_DRIVEN
  TRAVEL_FOCUSED
  NIGTH_OWL

  FOODIE_PARADISE
  CHILL_ZONES
}

enum PLACE_APPROXIMATE_DAILY_CONST_ENUM {
  CHEAP
  MODERATE
  EXPENSIVE
  VERY_EXPENSIVE
}

enum LANGUAGE_ENUM {
  SPANISH
  ENGLISH
  FRENCH
}

model Places {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  knownFor    String?
  description String?

  capacity             Int?
  languages            LANGUAGE_ENUM[]
  ambianceTags         AMBIENCE_TAG_ENUM[]
  themeTags            THEME_TAG_ENUM[]
  approximateDailyCost PLACE_APPROXIMATE_DAILY_CONST_ENUM?

  discoveredBy   User?    @relation(name: "PlaceDiscoveredBy", fields: [discoveredByID], references: [id])
  discoveredByID String?  @db.ObjectId
  confirmedBy    User[]   @relation(name: "PlaceConfirmedBy", fields: [confirmedByIDs], references: [id])
  confirmedByIDs String[] @db.ObjectId

  visitedBy    User[]   @relation(name: "PlaceVisitedBy", fields: [visitedByIDs], references: [id])
  visitedByIDs String[] @db.ObjectId

  discoveredDate DateTime?
  approvedDate   DateTime?
  rejectedDate   DateTime?

  confirmationStatus PlaceConfirmationStatus @default(RECOMMENDED)

  multimedia  Multimedia[]
  type        PlaceTypes[]
  location    Location
  commodities Commodities
  rules       PlaceRules
  sessions    PlaceSession[]
}

model DiscoveredPlaceConfirmation {
  id                   String                              @id @default(auto()) @map("_id") @db.ObjectId
  placeID              String                              @db.ObjectId
  confirmedByID        String                              @db.ObjectId
  name                 String
  capacity             Int?
  knownFor             String?
  description          String?
  confirmationStatus   PlaceConfirmationStatus
  multimedia           Multimedia[]
  type                 PlaceTypes[]
  location             Location
  commodities          Commodities
  rules                PlaceRules
  languages            LANGUAGE_ENUM[]
  ambianceTags         AMBIENCE_TAG_ENUM[]
  themeTags            THEME_TAG_ENUM[]
  approximateDailyCost PLACE_APPROXIMATE_DAILY_CONST_ENUM?
}

// ========================================
// ========================================
// Commodities
// ========================================
// ========================================

// ========================================
// Enums
enum WIFI_SPEED_COMMODITY_ENUM {
  SLOW
  MODERATE
  FAST
}

enum PARKING_COMMODITY_ENUM {
  IN_PLACE
  IN_STREET
  NEARBY
}

enum MOBILE_SIGNAL_COMMODITY_ENUM {
  WEAK
  MEDIUM
  STRONG
}

enum FOOD_COMMODITY_ENUM {
  FAST_FOOD
  RESTAURANT
  VEGAN
  VEGETARIAN
  CARNIVORE
  ALL
}

enum COMMODITY_QUALITY {
  VERY_BAD
  BAD
  REGULAR
  GOOD
  VERY_GOOD
  EXCELLENT
}

enum COMFORT_LEVEL_COMMODITY_ENUM {
  BASIC
  CASUAL
  ERGONOMIC
  LUXURIOUS
}

enum TEMPERATURE_CONTROL_COMMODITY_ENUM {
  AIR_CONDITIONING
  HEATING
}

// ========================================
// Schema

type Commodities {
  publicWifi          Boolean?
  wifiSpeed           WIFI_SPEED_COMMODITY_ENUM?
  parking             PARKING_COMMODITY_ENUM?
  publicPlugs         Boolean?
  plugsAmount         Int?
  coworkSpace         Boolean?
  publicBathrooms     Boolean?
  mobileSignal        MOBILE_SIGNAL_COMMODITY_ENUM?
  food                FOOD_COMMODITY_ENUM[]
  foodQuality         COMMODITY_QUALITY?
  comfortLevel        COMFORT_LEVEL_COMMODITY_ENUM?
  outdoorSeating      Boolean?
  temperatureControl  TEMPERATURE_CONTROL_COMMODITY_ENUM[]
  accessibility       Boolean?
  eventSpace          Boolean?
  greenAreas          Boolean?
  alcoholAvailability Boolean?
  cafe                Boolean?
  cafeQuality         COMMODITY_QUALITY?
  bakery              Boolean?
  bakeryQuality       COMMODITY_QUALITY?
}

// ========================================
// ========================================
// Rules
// ========================================
// ========================================

// ========================================
// Enums

enum NOISE_POLICY_RULE_ENUM {
  QUIET_ONLY
  MODERATE_NOISE_ALLOWED
  NO_NOISE_RESTRICTION
}

enum TIME_LIMIT_RULE_ENUM {
  NO_LIMIT
  UNLIMITED
  PER_HOUR
}

enum CONSUMPTION_POLICY_RULE_ENUM {
  PURCHASE_REQUIRED
  OUTSIDE_PURCHASE_ALLOWED
  NO_OUTSIDE_FOOD
}

enum PRIVACY_POLICY_RULE_ENUM {
  OPEN_WORKSPACE
  SHARED_DESKS
  PRIVATE_ROOM
  OUTSIDE_PURCHASE_ALLOWED
  NO_OUTSIDE_FOOD
}

// ========================================
// Schema
type PlaceRules {
  openAt            String
  closedAt          String
  petFriendly       Boolean?
  smoking           Boolean?
  underAge          Boolean?
  timeLimit         TIME_LIMIT_RULE_ENUM?
  noisePolicy       NOISE_POLICY_RULE_ENUM?
  consumptionPolicy CONSUMPTION_POLICY_RULE_ENUM?
  privacyPolicy     PRIVACY_POLICY_RULE_ENUM[]
}

enum PlaceTypes {
  LIBRARY
  COFFEE
  ROOFTOP
  COWORK_ZONE
  PARK
  LOOKOUT
}

type Location {
  latitude  Float
  longitude Float
  zone      String?
  city      String?
  country   String?
}

enum MULTIMEDIA_TYPE_ENUM {
  IMAGE
  VIDEO
}

type Multimedia {
  url         String
  type        MULTIMEDIA_TYPE_ENUM
  createdDate DateTime
}

model PlaceSession {
  id             String                @id @default(auto()) @map("_id") @db.ObjectId
  createdDate    DateTime
  endDate        DateTime
  recentActivity Multimedia[]
  place          Places                @relation(fields: [placeID], references: [id])
  placeID        String                @db.ObjectId
  users          User[]                @relation(fields: [usersIDs], references: [id])
  usersIDs       String[]              @db.ObjectId
  actions        PlaceSessionActions[]
}

model PlaceSessionActions {
  id             String                     @id @default(auto()) @map("_id") @db.ObjectId
  createdDate    DateTime
  payload        Json
  type           PLACE_SESSION_ACTIONS_ENUM
  dayTimeSection DAY_TIME_SECTION_ENUM
  placeSession   PlaceSession               @relation(fields: [placeSessionID], references: [id])
  placeSessionID String                     @db.ObjectId
  user           User                       @relation(fields: [userID], references: [id])
  userID         String                     @db.ObjectId
  username       String
}

enum DAY_TIME_SECTION_ENUM {
  EARLY_MORNING // 12am - 3am
  BEFORE_SUNRISE // 3am - 6am
  SUNRISE // 6am - 9am
  MORNING // 9am - 12pm
  MIDDAY // 12pm - 3pm
  AFTERNOON // 3pm - 6pm
  NIGHT // 6pm - 9pm
  LATE_NIGHT // 9pm - 11:59pm
}

enum PLACE_SESSION_ACTIONS_ENUM {
  MESSAGE
  UPDATE
  RECENT_ACTIVITY
  JOIN
  LEAVE
}
